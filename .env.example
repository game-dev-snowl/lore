# Copy to .env and edit. .env is git-ignored.

# Name clients use. Public mode: a real DNS name for Let's Encrypt (issue-cert.sh).
# LAN mode: any name your LAN resolves (router DNS or /etc/hosts), e.g. lore.lan;
# make-local-ca.sh puts it AND LORE_BIND_ADDR in the cert, so the IP works too.
# Clients connect to lores://$LORE_DOMAIN:41337
LORE_DOMAIN=lore.example.com

# Email for Let's Encrypt expiry notices (public mode only).
LETSENCRYPT_EMAIL=you@example.com

# Pinned loreserver image tag (ghcr.io/epicgames/lore/loreserver).
# Check https://github.com/EpicGames/lore/releases before bumping.
LORE_VERSION=0.13.0

# Host directory for the stores. Use an absolute path on a dedicated volume in production.
LORE_DATA_DIR=/srv/lore/data

# Address to publish 41337 on. 0.0.0.0 = all interfaces.
# LAN mode: the server's LAN IP (e.g. 192.168.1.50); Tailscale: its 100.x IP.
LORE_BIND_ADDR=0.0.0.0

# trace | debug | info | warn | error
RUST_LOG=info
