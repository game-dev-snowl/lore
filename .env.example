# Copy to .env and edit. .env is git-ignored.

# Public DNS name of this server. Must have an A/AAAA record pointing here
# before running scripts/issue-cert.sh. Clients connect to lores://$LORE_DOMAIN:41337
LORE_DOMAIN=lore.example.com

# Email for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=you@example.com

# Pinned loreserver image tag (ghcr.io/epicgames/lore/loreserver).
# Check https://github.com/EpicGames/lore/releases before bumping.
LORE_VERSION=0.10.1

# Host directory for the stores. Use an absolute path on a dedicated volume in production.
LORE_DATA_DIR=/srv/lore/data

# Address to publish 41337 on. 0.0.0.0 = public. Set to a WireGuard/Tailscale IP to keep it private.
LORE_BIND_ADDR=0.0.0.0

# trace | debug | info | warn | error
RUST_LOG=info
